<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp">

    <!-- Title is at the top left of the layout by default -->
    <TextView
        android:id="@+id/text_post_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:fontFamily="@font/lato_semibold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/image_post_preview"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        tools:text="This is a post title in compact layout" />

    <!-- Thumbnail preview is on the right by default -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_post_preview"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_post_title"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="4dp"
        android:scaleType="centerCrop"
        android:elevation="4dp"
        app:shapeAppearanceOverlay="@style/RoundedImageViewStyle"
        android:contentDescription="Post preview image"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <com.cosmos.unreddit.ui.common.widget.CardButton
        android:id="@+id/button_type_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="@id/image_post_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_post_preview"
        android:layout_margin="2dp"
        android:focusable="false"
        android:clickable="false"
        style="@style/CardButtonStyle"
        tools:icon="@drawable/ic_play"/>

    <!-- Flairs displayed below the title -->
    <include
        android:id="@+id/include_post_flairs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/text_post_title"
        app:layout_constraintEnd_toEndOf="@id/text_post_title"
        app:layout_constraintTop_toBottomOf="@id/text_post_title"
        layout="@layout/include_post_flairs"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="image_post_preview,text_post_title,include_post_flairs" />

    <com.cosmos.unreddit.ui.common.widget.AwardView
        android:id="@+id/awards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/barrier_bottom"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:paddingVertical="@dimen/award_chip_padding_vertical_post"
        android:paddingHorizontal="@dimen/award_chip_padding_horizontal_post"
        app:textStyle="@style/TextAppearanceAwardPost"/>

    <!-- User and Subreddit names always at the bottom, above the upvotes/comments line -->
    <include
        android:id="@+id/include_post_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/awards"
        app:layout_constraintBottom_toTopOf="@id/include_post_metrics"
        layout="@layout/include_post_info"/>

    <include
        android:id="@+id/include_post_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_post_info"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="4dp"
        layout="@layout/include_post_metrics"/>

</androidx.constraintlayout.widget.ConstraintLayout>
